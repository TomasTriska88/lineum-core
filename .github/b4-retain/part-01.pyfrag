import base64, hashlib, io, json, lzma, os, urllib.request, zipfile

repo=os.environ['GITHUB_REPOSITORY']; token=os.environ['GITHUB_TOKEN']; head=os.environ['GITHUB_SHA']
report_path='research/lineum-public-tolog-galactic-shape-b4.md'
primary_wf='.github/workflows/b4-localized-l1-primary.yml'
self_wf='.github/workflows/b4-retain-localized-l1-primary.yml'
parts=[f'.github/b4-retain/part-{i:02d}.pyfrag' for i in range(1,5)]
artifact_id=8947333992
artifact_sha='ca9a9ca05ffe0077ec15dce87ac8309a78b7f2ec114ef84d316f4202d535350c'
primary_sha='499dabf444bf442eb9c36927d67a51505166ce422f1e428794aa20def560f11d'
old_archive_sha='171f2862469b19cc0aa003f173fb87d093c1c960c6651bfb493f72a09140f36f'
BASE=0x3400

def api(method,path,payload=None,binary=False):
    data=None if payload is None else json.dumps(payload).encode()
    req=urllib.request.Request('https://api.github.com'+path,data=data,method=method,headers={
        'Accept':'application/vnd.github+json','Authorization':'Bearer '+token,
        'X-GitHub-Api-Version':'2022-11-28','User-Agent':'lineum-b4-retention'})
    with urllib.request.urlopen(req,timeout=120) as r: out=r.read()
    return out if binary else (json.loads(out) if out else None)

def h(data): return hashlib.sha256(data).hexdigest()
def once(text,old,new):
    assert text.count(old)==1,(old[:80],text.count(old)); return text.replace(old,new,1)
def between(text,a,b,new):
    i=text.index(a); j=text.index(b,i); return text[:i]+new+text[j:]
def decode(payload,n):
    acc=bits=0; out=bytearray()
    for c in ''.join(payload.split()):
        v=ord(c)-BASE; assert 0<=v<32768
        acc=(acc<<15)|v; bits+=15
        while bits>=8 and len(out)<n:
            bits-=8; out.append((acc>>bits)&255); acc&=(1<<bits)-1 if bits else 0
    assert len(out)==n; return bytes(out)
def encode(data):
    acc=bits=0; out=[]
    for b in data:
        acc=(acc<<8)|b; bits+=8
        while bits>=15:
            bits-=15; out.append(chr(BASE+((acc>>bits)&32767))); acc&=(1<<bits)-1 if bits else 0
    if bits: out.append(chr(BASE+(acc<<(15-bits))))
    s=''.join(out); return '\n'.join(s[i:i+96] for i in range(0,len(s),96))

ref=api('GET',f'/repos/{repo}/git/ref/heads/develop')['object']['sha']; assert ref==head,(ref,head)
commit=api('GET',f'/repos/{repo}/git/commits/{head}'); base_tree=commit['tree']['sha']
item=api('GET',f'/repos/{repo}/contents/{report_path}?ref={head}')
report_bytes=base64.b64decode(item['content']); report_blob_old=item['sha']
assert len(report_bytes)==66581 and h(report_bytes)=='1c0a51921868fc76a7696e2281621c40406d800ce3367f05c032c1283ae5bcd1'
report=report_bytes.decode()
old_heading='#### Normalized complete-history archive — XZ plus Unicode15'
i=report.rindex(old_heading); a=report.index('```text',i)+7; b=report.index('```',a)
old_payload=report[a:b]; old_archive=decode(old_payload,34756)
assert h(old_archive)==old_archive_sha; lzma.decompress(old_archive)

z=api('GET',f'/repos/{repo}/actions/artifacts/{artifact_id}/zip',binary=True); assert h(z)==artifact_sha
with zipfile.ZipFile(io.BytesIO(z)) as f:
    raw=f.read('b4-l1-primary.json'); env=json.loads(f.read('b4-l1-execution-environment.json'))
    source=json.loads(f.read('b4-l1-source-receipt.json')); tests=f.read('b4-l1-pytest.log').decode().strip()
assert len(raw)==228809 and h(raw)==primary_sha and '9 passed' in tests
assert source['commit_sha']=='c513a65f16a65f6f600864f55a4edcd5fdfc69a7'
data=json.loads(raw); c=data['classification']; lanes=data['lane_summary']
assert len(data['rows'])==28 and sum(x['runs'] for x in lanes.values())==28
assert c['baseline_primary_psi_recoveries']==2 and c['baseline_primary_full_state_recoveries']==0
assert c['spatial_transport_resolves_phi'] is False and c['lap8_specific_stabilization'] is False
assert data['fidelity_corrections']['physical_parameters_or_primary_thresholds_changed'] is False
