# -------------------------------------------------------------
# LIGHTWEIGHT AUDIT ARTIFACT POLICY
# -------------------------------------------------------------
# Ignore everything inside historical run directories by default
output_wp/runs/*/*

# MUST unignore the whitepaper contract suite directory & contents
!output_wp/runs/_whitepaper_contract/
!output_wp/runs/_whitepaper_contract/*

# WHITELIST: Lightweight metadata and summaries per run
!output_wp/runs/*/*_manifest.json
!output_wp/runs/*/_LOCK.json
!output_wp/runs/*/run_summary.csv
!output_wp/runs/*/*_rolling_metrics.json
!output_wp/runs/*/*_metrics_summary.csv
!output_wp/runs/*/*_multi_spectrum_summary.csv
!output_wp/runs/*/portal_params.json

# Explicitly exclude the quarantine archive entirely
output_wp/archive/

# Voynich data
data/voynich/*.jsonl
data/voynich/*.json
